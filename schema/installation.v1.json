{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal PaaS installation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "controlSubdomain",
    "originIPv4",
    "cloudflareZoneId",
    "platformRepository",
    "platformSha",
    "owners"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "domain": {
      "type": "string",
      "maxLength": 190
    },
    "controlSubdomain": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "originIPv4": {
      "type": "string",
      "format": "ipv4"
    },
    "cloudflareZoneId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "platformRepository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
    },
    "platformSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "previousWorkflowShas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "repositoryAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "login",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
          },
          "type": {
            "enum": [
              "User",
              "Organization"
            ]
          }
        }
      }
    }
  }
}
